                "version": "0",
                "lessThan": "51.1.76"
              }
            ],
            "defaultStatus": "unaffected"
          }
        ],
        "descriptions": [
          {
            "lang": "en",
            "value": "The King Addons for Elementor  WordPress plugin before 51.1.76 does not escape a user-supplied grid setting before reflecting it into an HTML attribute in an unauthenticated AJAX response, allowing attackers to execute arbitrary JavaScript in the browser of a visitor who is tricked into loading a crafted page."
          }
        ],
